{
  "schemaVersion": 1,
  "id": "ninepointlabs.fastmail-calendar",
  "name": "Fastmail Calendar",
  "version": "0.1.0",
  "author": "Ninepoint Labs",
  "license": "MIT",
  "description": "Native Omarchy calendar — Today, Week, Month and Year views with day detail and quick add-event — over CalDAV. Fastmail by default; any CalDAV server works.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Fastmail Calendar",
    "description": "Today's date or next event from your CalDAV calendars (Fastmail by default), with a Today/Week/Month/Year calendar panel, day detail and add-event form.",
    "category": "Time",
    "aliases": [
      "calendar",
      "fastmail calendar",
      "caldav",
      "agenda"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "view": "month",
      "showNextEvent": true,
      "showTime": false,
      "timeFormat": "12-hour"
    },
    "schema": [
      {
        "key": "showNextEvent",
        "type": "boolean",
        "label": "Show next event in bar",
        "defaultValue": true
      },
      {
        "key": "showTime",
        "type": "boolean",
        "label": "Show time in bar",
        "defaultValue": false
      },
      {
        "key": "timeFormat",
        "type": "enum",
        "label": "Time format",
        "options": [
          "12-hour",
          "24-hour"
        ],
        "defaultValue": "12-hour"
      },
      {
        "key": "view",
        "type": "enum",
        "label": "Default view",
        "options": [
          "today",
          "week",
          "month",
          "year"
        ],
        "defaultValue": "month"
      }
    ]
  }
}
